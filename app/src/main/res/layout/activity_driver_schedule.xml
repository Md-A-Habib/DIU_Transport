<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true"
    tools:context=".activity.driver_screen.DriverScheduleActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="My Assigned Bus Schedule"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- ================= SECTION 1: Campus -> Destination ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Campus ➔ Destination Trip"
            android:textColor="#4CAF50"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Table 1 Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:stretchColumns="0,1">

                <!-- Table Header Row -->
                <TableRow android:paddingBottom="8dp">
                    <TextView android:text="Destination" android:textColor="#AAAAAA" android:textStyle="bold" android:textSize="13sp" />
                    <TextView android:text="Bus No" android:textColor="#AAAAAA" android:textStyle="bold" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="Departure Time" android:textColor="#AAAAAA" android:textStyle="bold" android:textSize="13sp" android:gravity="end" />
                </TableRow>

                <View android:layout_height="1dp" android:background="#333333" android:layout_marginBottom="8dp"/>

                <!-- Row 1 -->
                <TableRow android:paddingBottom="8dp">
                    <TextView android:text="Dhanmondi" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <TextView android:text="Bus-04" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="01:30 PM" android:textColor="#FF9800" android:textSize="13sp" android:gravity="end" android:textStyle="bold"/>
                </TableRow>

                <!-- Row 2 -->
                <TableRow android:paddingBottom="8dp">
                    <TextView android:text="Mirpur-10" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <TextView android:text="Bus-02" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="03:30 PM" android:textColor="#FF9800" android:textSize="13sp" android:gravity="end" android:textStyle="bold"/>
                </TableRow>

                <!-- Row 3 -->
                <TableRow android:paddingBottom="8dp">
                    <TextView android:text="Mirpur-12" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <TextView android:text="Bus-09" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="04:00 PM" android:textColor="#FF9800" android:textSize="13sp" android:gravity="end" android:textStyle="bold"/>
                </TableRow>

                <!-- Row 4 -->
                <TableRow android:paddingBottom="8dp">
                    <TextView android:text="Uttara" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <TextView android:text="Bus-07" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="05:30 PM" android:textColor="#FF9800" android:textSize="13sp" android:gravity="end" android:textStyle="bold"/>
                </TableRow>

                <!-- Row 5 -->
                <TableRow android:paddingBottom="8dp">
                    <TextView android:text="Savar" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <TextView android:text="Bus-11" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="04:30 PM" android:textColor="#FF9800" android:textSize="13sp" android:gravity="end" android:textStyle="bold"/>
                </TableRow>

                <!-- Row 6 -->
                <TableRow android:paddingBottom="8dp">
                    <TextView android:text="Narayanganj" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <TextView android:text="Bus-15" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="05:00 PM" android:textColor="#FF9800" android:textSize="13sp" android:gravity="end" android:textStyle="bold"/>
                </TableRow>

                <!-- Row 7 -->
                <TableRow android:paddingBottom="8dp">
                    <TextView android:text="Gazipur" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <TextView android:text="Bus-03" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="04:15 PM" android:textColor="#FF9800" android:textSize="13sp" android:gravity="end" android:textStyle="bold"/>
                </TableRow>

                <!-- Row 8 -->
                <TableRow>
                    <TextView android:text="Mohakhali" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <TextView android:text="Bus-12" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="05:15 PM" android:textColor="#FF9800" android:textSize="13sp" android:gravity="end" android:textStyle="bold"/>
                </TableRow>

            </TableLayout>
        </androidx.cardview.widget.CardView>


        <!-- ================= SECTION 2: Destination -> Campus ================= -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Destination ➔ Campus Trip"
            android:textColor="#2196F3"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Table 2 Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#1E1E1E"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="12dp"
                android:stretchColumns="0,1">

                <!-- Table Header Row -->
                <TableRow android:paddingBottom="8dp">
                    <TextView android:text="Route Area" android:textColor="#AAAAAA" android:textStyle="bold" android:textSize="13sp" />
                    <TextView android:text="Bus No" android:textColor="#AAAAAA" android:textStyle="bold" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="Departure Time" android:textColor="#AAAAAA" android:textStyle="bold" android:textSize="13sp" android:gravity="end" />
                </TableRow>

                <View android:layout_height="1dp" android:background="#333333" android:layout_marginBottom="8dp"/>

                <!-- Row 1 -->
                <TableRow android:paddingBottom="8dp">
                    <TextView android:text="Dhanmondi" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <TextView android:text="Bus-04" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="07:30 AM" android:textColor="#4CAF50" android:textSize="13sp" android:gravity="end" android:textStyle="bold"/>
                </TableRow>

                <!-- Row 2 -->
                <TableRow android:paddingBottom="8dp">
                    <TextView android:text="Mirpur-10" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <TextView android:text="Bus-02" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="08:00 AM" android:textColor="#4CAF50" android:textSize="13sp" android:gravity="end" android:textStyle="bold"/>
                </TableRow>

                <!-- Row 3 -->
                <TableRow android:paddingBottom="8dp">
                    <TextView android:text="Mirpur-12" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <TextView android:text="Bus-09" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="08:10 AM" android:textColor="#4CAF50" android:textSize="13sp" android:gravity="end" android:textStyle="bold"/>
                </TableRow>

                <!-- Row 4 -->
                <TableRow android:paddingBottom="8dp">
                    <TextView android:text="Uttara" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <TextView android:text="Bus-07" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="08:15 AM" android:textColor="#4CAF50" android:textSize="13sp" android:gravity="end" android:textStyle="bold"/>
                </TableRow>

                <!-- Row 5 -->
                <TableRow android:paddingBottom="8dp">
                    <TextView android:text="Savar" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <TextView android:text="Bus-11" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="08:45 AM" android:textColor="#4CAF50" android:textSize="13sp" android:gravity="end" android:textStyle="bold"/>
                </TableRow>

                <!-- Row 6 -->
                <TableRow android:paddingBottom="8dp">
                    <TextView android:text="Narayanganj" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <TextView android:text="Bus-15" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="06:30 AM" android:textColor="#4CAF50" android:textSize="13sp" android:gravity="end" android:textStyle="bold"/>
                </TableRow>

                <!-- Row 7 -->
                <TableRow android:paddingBottom="8dp">
                    <TextView android:text="Gazipur" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <TextView android:text="Bus-03" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="07:00 AM" android:textColor="#4CAF50" android:textSize="13sp" android:gravity="end" android:textStyle="bold"/>
                </TableRow>

                <!-- Row 8 -->
                <TableRow>
                    <TextView android:text="Mohakhali" android:textColor="#FFFFFF" android:textSize="13sp" />
                    <TextView android:text="Bus-12" android:textColor="#FFFFFF" android:textSize="13sp" android:gravity="center" />
                    <TextView android:text="07:15 AM" android:textColor="#4CAF50" android:textSize="13sp" android:gravity="end" android:textStyle="bold"/>
                </TableRow>

            </TableLayout>
        </androidx.cardview.widget.CardView>

    </LinearLayout>
</ScrollView>