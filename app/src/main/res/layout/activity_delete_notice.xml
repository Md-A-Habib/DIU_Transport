<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true"
    tools:context=".DeleteNoticeActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Delete Notice"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Notice Title / ID Input Field -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:boxBackgroundColor="#1E1E1E"
            app:boxBackgroundMode="outline"
            app:boxStrokeColor="#FF5252"
            app:hintTextColor="#FF5252">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etDeleteNoticeTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Notice Title (e.g., Holiday)"
                android:inputType="text"
                android:textColor="#FFFFFF"
                android:textSize="16sp" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Delete Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemoveNotice"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Delete Notice"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:backgroundTint="#FF5252"
            app:cornerRadius="12dp" />

    </LinearLayout>
</ScrollView>