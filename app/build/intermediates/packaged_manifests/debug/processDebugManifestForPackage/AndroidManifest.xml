<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.diu.transportapp"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="24"
        android:targetSdkVersion="36" />

    <uses-permission android:name="android.permission.INTERNET" />

    <permission
        android:name="com.diu.transportapp.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.diu.transportapp.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.DIU_Transport" >
        <activity
            android:name="com.diu.transportapp.activity.SplashActivity"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.diu.transportapp.activity.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.diu.transportapp.activity.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name="com.diu.transportapp.activity.HomeActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.ApplyTransportActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.RoutesActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.NoticeActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.ComplaintsActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.UpdateProfileActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.ChangePasswordActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.AdminDashboardActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.AdminDriverActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.AddDriverActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.ManageDriversActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.AdminRouteActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.AddRouteActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.ManageRoutesActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.UpdateRouteActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.AdminNoticeActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.AddNoticeActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.ManageNoticesActivity"
            android:exported="false" />
        <activity
            android:name="com.diu.transportapp.activity.AdminComplaintsActivity"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.diu.transportapp.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>